AR\" id=\"kK}Kc!5yUIT1;Ppq!w*E\">coin</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"spritescreate\"><value name=\"img\"><shadow type=\"screen_image_picker\"><field name=\"img\">img`\n. . . . . . . . . . . . . . . . \n. . . . . . . . . . . . . . . . \n. . . . . . . . . . . . . . . . \n. . . . . . f f f f . . . . . . \n. . . . f f 5 5 5 5 f f . . . . \n. . . . f 5 5 5 5 5 5 f . . . . \n. . . f 5 5 5 4 4 5 5 5 f . . . \n. . . f 5 5 5 4 4 5 5 5 f . . . \n. . . f 5 5 5 4 4 5 5 5 f . . . \n. . . f 5 5 5 4 4 5 5 5 f . . . \n. . . . f 5 5 5 5 5 5 f . . . . \n. . . . f f 5 5 5 5 f f . . . . \n. . . . . . f f f f . . . . . . \n. . . . . . . . . . . . . . . . \n. . . . . . . . . . . . . . . . \n. . . . . . . . . . . . . . . . \n`</field><data>{\"commentRefs\":[],\"fieldData\":{\"img\":null}}</data></shadow></value><value name=\"kind\"><shadow type=\"spritekind\"><field name=\"MEMBER\">Coin</field></shadow></value></block></value><next><block type=\"mapplaceontile\"><value name=\"sprite\"><block type=\"variables_get\"><field name=\"VAR\" id=\"kK}Kc!5yUIT1;Ppq!w*E\">coin</field></block></value><value name=\"loc\"><shadow type=\"mapgettile\"></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\"vi?DT8`EKu5i@v7r_vgQ\">value7</field></block></value><next><block type=\"attachAnimation\"><value name=\"set\"><block type=\"variables_get\"><field name=\"VAR\" id=\"mu,+s)$fFddaBz`lE#qk\">coinAnimation</field></block></value><value name=\"sprite\"><block type=\"variables_get\"><field name=\"VAR\" id=\"kK}Kc!5yUIT1;Ppq!w*E\">coin</field></block></value><next><block type=\"setAction\"><value name=\"action\"><shadow type=\"action_enum_shim\"><field name=\"MEMBER\">Walking</field></shadow></value><value name=\"sprite\"><block type=\"variables_get\"><field name=\"VAR\" id=\"kK}Kc!5yUIT1;Ppq!w*E\">coin</field></block></value><next><block type=\"mapsettileat\"><value name=\"tile\"><shadow type=\"tileset_tile_picker\"><field name=\"tile\">assets.tile`tile0`</field></shadow></value><value name=\"loc\"><shadow type=\"mapgettile\"></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\"vi?DT8`EKu5i@v7r_vgQ\">value7</field></block></value></block></next></block></next></block></next></block></next></block></statement></block></statement></block></xml>","main.ts":"namespace SpriteKind {\n    export const Weapon = SpriteKind.create()\n    export const EnemyShot = SpriteKind.create()\n    export const RLEnemy = SpriteKind.create()\n}\n\n// ==========================================\n// 1. 게임 기본 설정 & 물리 (기존 컨트롤 구조 유지)\n// ==========================================\nconst GROUND_Y = 108\nconst pixelsToMeters = 30\nconst gravity = 9.81 * pixelsToMeters\nconst invincibilityPeriod = 800\n\nlet heroFacingLeft = false\nlet canDoubleJump = false\nlet doubleJumpSpeed = 0\nlet armorState = 2 // 2: 갑옷 기사, 1: 팬티 기사\nlet isInvincible = false\nlet rlKills = 0\n\n// ==========================================\n// 2. 초경량 강화학습 (Q-Learning) 설정\n// ==========================================\n// 상태(State): 거리(3) x 창 위협여부(2) x 상대높이(3) = 18개\n// 행동(Action): 0:돌진, 1:후퇴, 2:회피점프, 3:화염구 발사 = 4개\nconst NUM_STATES = 18\nconst NUM_ACTIONS = 4\nlet qTable: number[] = []\nfor (let i = 0; i < NUM_STATES * NUM_ACTIONS; i++) {\n    qTable.push(0)\n}\n\nlet alpha = 0.25      // 학습률 (Learning Rate)\nlet gamma = 0.85      // 할인율 (Discount Factor)\nlet epsilon = 0.35    // 탐험 확률 (Exploration Rate)\n\nlet lastState = 0\nlet lastAction = 0\nlet stepReward = 0\nlet enemyHP = 3\n\n// ==========================================\n// 3. 스프라이트 이미지 (기사, 팬티기사, 창, 악마, 화염구)\n// ==========================================\nconst imgKnightRight = img`\n    . . . . . . 2 2 2 . . . . . . .\n    . . . . . 9 9 9 9 9 . . . . . .\n    . . . . 9 1 9 9 9 9 9 . . . . .\n    . . . . 9 9 f f f 9 9 . . . . .\n    . . . . 9 9 d d d 9 9 . . . . .\n    . . . . . 9 9 9 9 9 . . . . . .\n    . . . . 9 1 9 9 9 1 9 . . . . .\n    . . . 9 9 9 9 9 9 9 9 9 . . . .\n    . . . 9 . 9 9 1 9 9 . 9 . . . .\n    . . . . . 9 9 9 9 9 . . . . . .\n    . . . . . 9 9 . 9 9 . . . . . .\n    . . . . . 9 9 . 9 9 . . . . . .\n    . . . . . c c . c c . . . . . .\n    . . . . . c c c c c c . . . . .\n    . . . . . . . . . . . . . . . .\n    . . . . . . . . . . . . . . . .\n`\nconst imgKnightLeft = imgKnightRight.clone()\nimgKnightLeft.flipX()\n\nconst imgBoxerRight = img`\n    . . . . . . e e e . . . . . . .\n    . . . . . e e e e e . . . . . .\n    . . . . . d d f d d . . . . . .\n    . . . . . d d d d d . . . . . .\n    . . . . . . d d d . . . . . . .\n    . . . . . d d d d d . . . . . .\n    . . . . d d d d d d d . . . . .\n    . . . . d . d d d . d . . . . .\n    . . . . . . 1 1 1 . . . . . . .\n    . . . . . 1 2 1 2 1 . . . . . .\n    . . . . . 1 1 . 1 1 . . . . . .\n    . . . . . d d . d d . . . . . .\n    . . . . . d d . d d . . . . . .\n    . . . . . e e . e e . . . . . .\n    . . . . . . . . . . . . . . . .\n    . . . . . . . . . . . . . . . .\n`\nconst imgBoxerLeft = imgBoxerRight.clone()\nimgBoxerLeft.flipX()\n\nconst imgDemon = img`\n    . . . 2 . . . . . . . 2 . . . .\n    . . 2 2 . . 2 2 2 . . 2 2 . . .\n    . 2 2 . . 2 2 2 2 2 . . 2 2 . .\n    . 2 . . 2 2 5 2 5 2 2 . . 2 . .\n    . . . . 2 2 2 2 2 2 2 . . . . .\n    . . . 2 2 2 f f f 2 2 2 . . . .\n    . . 2 2 2 2 2 2 2 2 2 2 2 . . .\n    . 2 2 . 2 2 4 4 4 2 2 . 2 2 . .\n    . 2 . . . 2 2 2 2 2 . . . 2 . .\n    . . . . . 2 2 . 2 2 . . . . . .\n    . . . . 2 2 . . . 2 2 . . . . .\n    . . . . f f . . . f f . . . . .\n`\n\nconst imgLanceRight = img`\n    . . . . . . . . . . 1 1 . . . .\n    e e e e e e e e e 1 1 1 1 . . .\n    . . . . . . . . . . 1 1 . . . .\n`\nconst imgLanceLeft = imgLanceRight.clone()\nimgLanceLeft.flipX()\n\nconst imgFireball = img`\n    . . 2 2 . .\n    . 2 4 5 2 .\n    2 4 5 5 4 2\n    . 2 4 5 2 .\n    . . 2 2 . .\n`\n\n// ==========================================\n// 4. 배경(마계촌 묘지) 및 캐릭터 초기화\n// ==========================================\nfunction setupBackground() {\n    let bg = image.create(160, 120)\n    bg.fill(15) // 어두운 밤하늘\n    // 보름달\n    bg.fillCircle(130, 25, 12, 5)\n    // 멀리 보이는 묘비 실루엣\n    bg.fillRect(25, 92, 8, 16, 11)\n    bg.fillRect(23, 96, 12, 3, 11)\n    bg.fillRect(110, 94, 10, 14, 11)\n    // 바닥\n    bg.fillRect(0, GROUND_Y, 160, 12, 13)\n    bg.fillRect(0, GROUND_Y, 160, 2, 7) // 이끼 낀 잔디\n    scene.setBackgroundImage(bg)\n}\n\nsetupBackground()\n\nlet hero = sprites.create(imgKnightRight, SpriteKind.Player)\nhero.setPosition(30, GROUND_Y - 10)\nhero.ay = gravity\nhero.setStayInScreen(true)\ncontroller.moveSprite(hero, 100, 0)\ninfo.setLife(3)\ninfo.setScore(0)\n\nlet demon = sprites.create(imgDemon, SpriteKind.RLEnemy)\ndemon.setPosition(130, GROUND_Y - 10)\ndemon.ay = gravity\ndemon.setStayInScreen(true)\n\n// ==========================================\n// 5. 기존 컨트롤 구조 유지 + B버튼 창 던지기\n// ==========================================\nfunction isOnGround(s: Sprite): boolean {\n    return s.bottom >= GROUND_Y\n}\n\nfunction attemptJump() {\n    if (isOnGround(hero)) {\n        hero.vy = -4 * pixelsToMeters\n    } else if (canDoubleJump) {\n        doubleJumpSpeed = -3 * pixelsToMeters\n        if (hero.vy >= -40) {\n            doubleJumpSpeed = -4.5 * pixelsToMeters\n            hero.startEffect(effects.trail, 300)\n            scene.cameraShake(2, 150)\n        }\n        hero.vy = doubleJumpSpeed\n        canDoubleJump = false\n    }\n}\n\ncontroller.A.onEvent(ControllerButtonEvent.Pressed, function () {\n    attemptJump()\n})\n\ncontroller.up.onEvent(ControllerButtonEvent.Pressed, function () {\n    attemptJump()\n})\n\ncontroller.down.onEvent(ControllerButtonEvent.Pressed, function () {\n    if (!isOnGround(hero)) {\n        hero.vy += 80\n    }\n})\n\n// 마계촌 무기: 창 던지기 (B 버튼)\ncontroller.B.onEvent(ControllerButtonEvent.Pressed, function () {\n    if (sprites.allOfKind(SpriteKind.Weapon).length >= 2) return // 화면에 최대 2개 제한\n    let lance = sprites.create(heroFacingLeft ? imgLanceLeft : imgLanceRight, SpriteKind.Weapon)\n    lance.setPosition(hero.x, hero.y)\n    lance.vx = heroFacingLeft ? -160 : 160\n    lance.setFlag(SpriteFlag.AutoDestroy, true)\n    music.pewPew.play()\n})\n\n// ==========================================\n// 6. 강화학습(Q-Learning) 핵심 로직\n// ==========================================\nfunction getRLState(): number {\n    // 1) 플레이어와의 거리 (0: 가까움, 1: 중간, 2: 멂)\n    let dist = Math.abs(demon.x - hero.x)\n    let distBin = dist < 40 ? 0 : (dist < 85 ? 1 : 2)\n\n    // 2) 플레이어의 창이 다가오고 있는지 (0: 안전, 1: 위험)\n    let danger = 0\n    for (let w of sprites.allOfKind(SpriteKind.Weapon)) {\n        if (Math.abs(w.x - demon.x) < 48 && Math.abs(w.y - demon.y) < 18) {\n            danger = 1\n            break\n        }\n    }\n\n    // 3) 플레이어의 상대 높이 (0: 비슷, 1: 플레이어가 위, 2: 적이 위)\n    let dy = hero.y - demon.y\n    let heightBin = Math.abs(dy) < 15 ? 0 : (dy < 0 ? 1 : 2)\n\n    return distBin * 6 + danger * 3 + heightBin\n}\n\nfunction chooseAction(state: number): number {\n    // Epsilon-Greedy 정책\n    if (Math.random() < epsilon) {\n        return Math.randomRange(0, NUM_ACTIONS - 1)\n    }\n    let bestAction = 0\n    let bestVal = qTable[state * NUM_ACTIONS]\n    for (let a = 1; a < NUM_ACTIONS; a++) {\n        let val = qTable[state * NUM_ACTIONS + a]\n        if (val > bestVal) {\n            bestVal = val\n            bestAction = a\n        }\n    }\n    return bestAction\n}\n\nfunction updateQTable(prevState: number, action: number, reward: number, nextState: number) {\n    let maxNextQ = qTable[nextState * NUM_ACTIONS]\n    for (let a = 1; a < NUM_ACTIONS; a++) {\n        let v = qTable[nextState * NUM_ACTIONS + a]\n        if (v > maxNextQ) maxNextQ = v\n    }\n    let idx = prevState * NUM_ACTIONS + action\n    qTable[idx] = qTable[idx] + alpha * (reward + gamma * maxNextQ - qTable[idx])\n}\n\nfunction executeDemonAction(action: number) {\n    let dirToHero = hero.x < demon.x ? -1 : 1\n    if (action == 0) {\n        // 0: 돌진\n        demon.vx = dirToHero * 55\n    } else if (action == 1) {\n        // 1: 후퇴 (거리 벌리기)\n        demon.vx = -dirToHero * 55\n    } else if (action == 2) {\n        // 2: 회피 점프\n        if (isOnGround(demon)) {\n            demon.vy = -110\n        }\n        demon.vx = dirToHero * 25\n    } else if (action == 3) {\n        // 3: 화염구 발사\n        demon.vx = 0\n        if (sprites.allOfKind(SpriteKind.EnemyShot).length < 2) {\n            let fire = sprites.create(imgFireball, SpriteKind.EnemyShot)\n            fire.setPosition(demon.x, demon.y)\n            fire.vx = dirToHero * 95\n            fire.setFlag(SpriteFlag.AutoDestroy, true)\n        }\n    }\n}\n\n// 0.25초마다 강화학습 에이전트(적) 의사결정 및 Q-Table 업데이트\ngame.onUpdateInterval(250, function () {\n    let currentState = getRLState()\n\n    // 창을 성공적으로 피했거나(위험 상태에서 안 맞음) 생존 시 소폭 보상\n    stepReward += 0.2\n\n    // 이전 행동에 대한 Q값 갱신\n    updateQTable(lastState, lastAction, stepReward, currentState)\n    stepReward = 0\n\n    // 새 행동 선택 및 실행\n    let action = chooseAction(currentState)\n    executeDemonAction(action)\n\n    lastState = currentState\n    lastAction = action\n\n    // 점진적으로 탐험 비율 감소 (최소 0.08 유지)\n    if (epsilon > 0.08) {\n        epsilon -= 0.001\n    }\n})\n\n// ==========================================\n// 7. 충돌 처리 (갑옷 파괴, 피격, 보상 부여)\n// ==========================================\nfunction damageHero() {\n    if (isInvincible) return\n    isInvincible = true\n    stepReward += 10 // 적 AI에게 큰 양의 보상!\n    music.powerDown.play()\n\n    if (armorState == 2) {\n        armorState = 1\n        hero.say(\"갑옷 파괴!\", 600)\n        hero.startEffect(effects.ashes, 300)\n    } else {\n        info.changeLifeBy(-1)\n        armorState = 2 // 부활 시 갑옷 복구\n        hero.say(\"으악!\", 600)\n    }\n\n    hero.vy = -60\n    timer.after(invincibilityPeriod, function () {\n        isInvincible = false\n    })\n}\n\nsprites.onOverlap(SpriteKind.Player, SpriteKind.RLEnemy, function (sprite, otherSprite) {\n    damageHero()\n})\n\nsprites.onOverlap(SpriteKind.Player, SpriteKind.EnemyShot, function (sprite, otherSprite) {\n    otherSprite.destroy()\n    damageHero()\n})\n\nsprites.onOverlap(SpriteKind.Weapon, SpriteKind.RLEnemy, function (weapon, enemy) {\n    weapon.destroy()\n    enemyHP -= 1\n    stepReward -= 10 // 적 AI에게 큰 페널티!\n    enemy.startEffect(effects.fire, 150)\n    music.baDing.play()\n\n    if (enemyHP <= 0) {\n        rlKills += 1\n        info.changeScoreBy(10)\n        enemyHP = 3\n        // 적은 죽어도 Q-Table을 유지한 채 반대편에서 리스폰 (계속 학습)\n        enemy.setPosition(hero.x < 80 ? 145 : 15, GROUND_Y - 10)\n        enemy.say(\"Lv.\" + rlKills + \" 학습중\", 800)\n    }\n})\n\n// ==========================================\n// 8. 매 프레임 업데이트 (바닥 충돌, 스프라이트 방향)\n// ==========================================\ngame.onUpdate(function () {\n    // 바닥 고정 및 더블 점프 리셋\n    if (hero.bottom >= GROUND_Y) {\n        hero.bottom = GROUND_Y\n        hero.vy = 0\n        canDoubleJump = true\n    }\n    if (demon.bottom >= GROUND_Y) {\n        demon.bottom = GROUND_Y\n        demon.vy = 0\n    }\n\n    // 기사 방향 및 갑옷/팬티 상태에 따른 이미지 갱신\n    if (hero.vx < 0) heroFacingLeft = true\n    else if (hero.vx > 0) heroFacingLeft = false\n\n    if (armorState == 2) {\n        hero.setImage(heroFacingLeft ? imgKnightLeft : imgKnightRight)\n    } else {\n        hero.setImage(heroFacingLeft ? imgBoxerLeft : imgBoxerRight)\n    }\n})","README.md":" ","assets.json":"","tilemap.g.jres":"{\n    \"transparency16\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"tilemapTile\": true\n    },\n    \"tile0\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\n      